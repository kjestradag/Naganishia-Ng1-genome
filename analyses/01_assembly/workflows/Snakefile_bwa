rule bwa:
    input:
        expand("{fq1}", fq1=FQ1),
        expand("{fq2}", fq2=FQ2),
        expand("{ref}.bwt", ref=REF)
    output:
        temp("{prefix}.raw.sam")
    threads:
        workflow.cores
    message:
        "BWA mem.."
    shell:
        '''
        bwa mem -rf -t {threads} {REF} {input[0]} {input[1]} -o {output}
#        rm -f {REF}.*
        '''

rule convert:
    input:
        rules.bwa.output
    output:
        temp("{prefix}.raw.bam")
    threads:
        workflow.cores
    message:
        "converting to bam.."
    shell:
        "samtools view -@ {threads} -Sb {input} > {output}"

        # keep only reads properly paired
            # -F 4: Excluye los reads que no están alineados (es decir, los reads que tienen el flag 0x4 en el BAM)
            # -f 3: Incluye solo los reads que están alineados y tienen ambos pares de lectura (es decir, los reads que tienen el flag 0x1 y 0x2)
        #"samtools view -@ {threads} -F 4 -f 3 -Sb {input} > {output}"

rule stats:
    input:
        rules.convert.output
    output:
        "{prefix}.raw.stats"
    threads:
        1
    message:
        "alignment stats.."
    shell:
        "bamtools stats -in {input} > {output}"

# raw.stats se calcula sobre el BAM crudo, ANTES de rule filter, asi que su
# "Mapped reads" refleja el criterio permisivo de bwa mem (alineamiento local
# desde ~30 pb) y sobreestima el hospedero por un orden de magnitud.
# host90.stats lo calcula sobre el BAM ya filtrado a >=90% de la lectura
# alineada, que es el hospedero real. Se conservan los dos para poder comparar.
rule stats_host:
    # nombre literal y no rules.mdup.output: rule mdup se define mas abajo en
    # este archivo y aun no existe al parsear esta regla.
    #
    # No basta `bamtools stats` sobre el BAM filtrado: su denominador es ese
    # mismo BAM, asi que siempre reporta "Mapped reads: N (100%)". El helper
    # toma el total del metagenoma desde raw.stats y da la fraccion real.
    input:
        bam = "{prefix}.mapped.sortn_fixmate_sortc_rdup_bam",
        raw = "{prefix}.raw.stats"
    output:
        "{prefix}.host90.stats"
    threads:
        1
    message:
        "host alignment stats (filtro >=90%).."
    shell:
        "host_stats_resume.sh {input.bam} {input.raw} {output}"

