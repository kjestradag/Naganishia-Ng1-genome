rule bwaindex:
    input:
        ref = "{ref}"
    params:
        idx = lambda wildcards: IDX
    output:
        #temp("{ref}.bwt")
        "{ref}.bwt"
    threads:
        2
    message:
        "BWA index.."
    shell:
        "bwa index -a {params.idx} {input.ref}"
#       Genomas grandes
