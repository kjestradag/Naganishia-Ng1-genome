# Separa hospedero / no-hospedero exigiendo que >=90% de la lectura alinee.
#
# Por que no basta -F 4 (comportamiento anterior, ver .bak):
#   bwa mem hace alineamiento LOCAL y acepta desde ~30 pb coincidentes (-T 30),
#   asi que en metagenoma vs genoma de hospedero reporta como "mapeada"
#   cualquier lectura con un tramo corto pegado a una repeticion. Medido en
#   Heces_128G vs Capra hircus: 21.8 M lecturas daban "mapeadas" (25.8%), pero
#   el 98.2% de ellas tenia <40% de la lectura alineada, y la cobertura del
#   genoma era 4.4% de amplitud a 0.169x -- incompatible con hospedero real
#   (serian >60% y 1.13x). El hospedero genuino resulto ser ~0.4%.
#   Con -F 4 se descartaba ~25% de senal microbiana legitima.
#
# (qlen-sclen)/qlen = fraccion de la lectura no soft-clipeada. Validado contra
# sum(M,=,X)/len(SEQ): 350,284 vs 350,173 lecturas (0.03% de diferencia).
# Las dos ramas son complementarias y suman los primarios totales.
rule filter:
    input:
        rules.convert.output
    output:
        temp("{prefix}.{map}.bam")
    threads:
        2
    message:
        "mapped reads filter (>=90% de la lectura alineada).."
    shell:
        '''
        if [ {wildcards.map} = "mapped" ]
        then
            # Hospedero: primario, mapeado y con <=10% de soft-clipping
            samtools view -@ {threads} -F 0x904 \
                -e '(qlen-sclen)/qlen >= 0.9' -b {input} > {output}
        else
            # No hospedero: sin mapear, o alineado de forma demasiado parcial
            samtools view -@ {threads} -F 0x900 \
                -e 'flag.unmap || sclen/qlen > 0.1' -b {input} > {output}
        fi
        '''

rule sortn:
    input:
        rules.filter.output
    output:
        temp("{prefix}.{map}.sortn_bam")
    threads:
        workflow.cores
    message:
        "sorting byname mapped and unmapped reads.."
    shell:
        # si quiero sacar fastqs o fixmate para poder usar markdup ordeno por nombres
        "samtools sort -t {threads} -n {input} -o {output}"

rule fastq_unmapped:
    input:
        "{prefix}.unmapped.sortn_bam"
    output:
        "{prefix}.unmapped.R1_fastq",
        "{prefix}.unmapped.R2_fastq",
        "{prefix}.unmapped.singles_fastq"
    threads:
        workflow.cores/2
    message:
        "extracting fastqs for unmapped reads.."
    shell:
        "samtools fastq --threads {threads} {input[0]} -1 {output[0]} -2 {output[1]} -s {output[2]}"

rule fixmate:
    input:
        "{prefix}.mapped.sortn_bam"
    output:
        temp("{prefix}.mapped.sortn_fixmate_bam")
    threads:
        workflow.cores/2
    message:
        "fixmate.."
    shell:
        "samtools fixmate --threads {threads} -m {input} {output}"

rule sortc:
    input:
        rules.fixmate.output
    output:
        temp("{prefix}.mapped.sortn_fixmate_sortc_bam")
    threads:
        workflow.cores
    message:
        "sorting by coords mapped reads.."
    shell:
        # para ordenar por coordenadas (por ejemplo para tablet o duplicados)
        "samtools sort -t {threads} {input} -o {output}"

rule mdup:
    input:
        rules.sortc.output
    output:
        "{prefix}.mapped.sortn_fixmate_sortc_rdup_bam"
    threads:
        workflow.cores
    message:
        "removing|marking optical duplicates.."
    shell:
        # remueve duplicados
        # "samtools markdup --threads {threads} -r -s {input} {output}"
        # solo marca duplicados
        "samtools markdup --threads {threads} -s {input} {output}"

rule sortdn:
    input:
        rules.mdup.output
    output:
        temp("{prefix}.mapped.sortn_fixmate_sortc_rdup_sortn_bam")
    threads:
        workflow.cores
    message:
        "sort by names before get fastqs for mapped reads.."
    shell:
        # si quiero sacar fastqs ordeno por nombres
        "samtools sort -t {threads} -n {input} -o {output}"

rule fastq:
    input:
        rules.sortdn.output
    output:
        "{prefix}.mapped.R1_fastq",
        "{prefix}.mapped.R2_fastq",
        "{prefix}.mapped.singles_fastq"
    threads:
        workflow.cores/2
    message:
        "extracting fastqs for mapped reads.."
    shell:
        "samtools fastq --threads {threads} {input[0]} -1 {output[0]} -2 {output[1]} -s {output[2]}"


rule coverage:
    input:
        rules.sortc.output,
        rules.mdup.output
    output:
        temp("{prefix}.mapped.sortn_fixmate_sortc_rdup_coverage"),
        temp("{prefix}.mapped.sortn_fixmate_sortc_rdup_coverage_mdup")
    threads:
        2
    message:
        "coverage for mapped reads.."
    shell:
        '''
        # para ordenar por coordenas (por ejemplo para tablet o duplicados)
        samtools coverage {input[0]} -o {output[0]}
        samtools coverage {input[1]} -o {output[1]}
        '''

rule coverage_table:
    input:
        rules.stats.output,
        rules.coverage.output,
        rules.fastq_unmapped.output,
        rules.fastq.output
    output:
        "{prefix}.mapped.coverage_resume"
    threads:
        1
    message:
        "coverage stats resume.."
    shell:
        '''
        # para tener una tabla resumen de las coberturas
        coverage_relabund.l {input[0]} {input[2]} {input[1]} > {output}
        rename.ul  '.R1_fastq' '.R1.fastq' *
        rename.ul  '.R2_fastq' '.R2.fastq' *
        '''

